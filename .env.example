# Скопируйте в .env или экспортируйте переменные перед запуском живых тестов.

# Базовый URL ncins-core-api (контур INT из комментариев NCINS-305 / NCINS-277)
NCINS_BASE_URL=https://int.ufrulkint-api.moscow.alfaintra.net/ufr-eos-ul-ncins-core-api

# Включить запросы в реальный стенд (без этого флага гоняется mock-контур)
NCINS_LIVE=0

# Не проверять TLS-сертификат корпоративного стенда
NCINS_VERIFY_SSL=false

NCINS_TIMEOUT=60

# Заголовки UFR (как в atest application-ufr-int.properties)
NCINS_A_USER_ID=123456
NCINS_A_CUSTOMER_ID=123456
NCINS_A_CLIENT_TYPE=UL
NCINS_A_CHANNEL_ID=NIB

# Данные для POST /v1/doc/generate-form (NCINS-277)
NCINS_CUS=UAAAJ7
NCINS_MANAGER_AD_LOGIN=eosManager
NCINS_MANAGER_FIO=Акрилов Эдуард Петрович
NCINS_MANAGER_POSITION=Менеджер отделения по обслуживанию ЮЛ
NCINS_MANAGER_BRANCH_NAME=0262
NCINS_MANAGER_BRANCH_CODE=MONY
NCINS_GROUP=UFCASH_DEPUTY_HEAD

# Если задан, шаг генерации ПФ пропускается и сразу качается этот fileId (NCINS-305)
# NCINS_FILE_ID=285946b0-002e-428c-b1e1-d5c558e81c24

# operationId для POST /v1/doc/download-signed (NCINS-306).
# INT (основной стенд):
# NCINS_OPERATION_ID=6a8fe2fdecea715b0ef88222
# Пример из комментария Jira / DEV:
# NCINS_OPERATION_ID=6a8f275decea715b0ef88213
